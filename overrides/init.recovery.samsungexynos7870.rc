# SM-T583 (gtaxladwifikx) recovery bring-up.
# Pixel format is ABGR_8888 in the product makefile. Do not write brightness here.
# USB ids match stock recovery: 04e8:6860. The gadget stays disabled until
# adbd has created /dev/usb-ffs/adb/ep1. Enabling earlier advertises an empty
# functionfs config; the host then hard-resets the link and adb never enumerates.
# Do not set sys.usb.config or sys.usb.ffs.ready here. The first restarts adbd,
# and the second claims the descriptors exist before adbd has written them.
# A write to /sys/fs/selinux/enforce returns 0 and the kernel stays enforcing.

on early-init
    write /sys/fs/selinux/enforce 0
    write /sys/devices/virtual/sec/sec_wdt/wdt_control 0
    write /sys/class/sec/sec_wdt/wdt_control 0
    write /sys/devices/platform/s3c2410-wdt/wdt_disable 1
    write /proc/sys/kernel/panic 0
    write /proc/sys/kernel/panic_on_oops 0
    write /proc/sys/kernel/hung_task_timeout_secs 0
    setprop sys.usb.configfs 0
    setprop sys.usb.ffs.aio_compat 1
    setprop persist.adb.nonblocking_ffs 0

on init
    write /sys/fs/selinux/enforce 0
    write /sys/devices/virtual/sec/sec_wdt/wdt_control 0
    write /sys/class/sec/sec_wdt/wdt_control 0
    write /proc/sys/kernel/panic 0
    write /proc/sys/kernel/panic_on_oops 0
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    start watchdogd

on fs
    write /sys/fs/selinux/enforce 0
    write /sys/devices/virtual/sec/sec_wdt/wdt_control 0
    write /proc/sys/kernel/panic_on_oops 0
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000,rmode=0770,fmode=0660
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 04e8
    write /sys/class/android_usb/android0/idProduct 6860
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/iManufacturer Samsung
    write /sys/class/android_usb/android0/iProduct SM-T583
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    start watchdogd
    start adbd
    wait /dev/usb-ffs/adb/ep1 15
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1

on boot
    write /sys/fs/selinux/enforce 0

service watchdogd /sbin/watchdogd.sh
    class core
    seclabel u:r:recovery:s0
